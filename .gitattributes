# Shell scripts must keep LF endings or they fail under WSL/Linux after a Windows checkout
*.sh   text eol=lf
*.py   text eol=lf
*.c    text eol=lf
*.h    text eol=lf
Makefile text eol=lf
*.pdf  binary
*.png  binary
# The second-machine data keep their original line endings so that SHA256SUMS stays valid
benchmark/results_pc_i5-13500_wsl2/** -text
